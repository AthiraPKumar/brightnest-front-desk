# Copy to .env for local testing. Set real values in Vercel → Settings → Environment Variables.
# Never commit a real key.
xAI_API_New=
# Optional: override the Grok model (default: grok-4.20-0309-non-reasoning)
XAI_MODEL=
# Optional: override the Grok Voice model (default: grok-voice-3.0)
XAI_VOICE_MODEL=
# Optional: override the Grok Voice voice (default: ara)
XAI_VOICE=
